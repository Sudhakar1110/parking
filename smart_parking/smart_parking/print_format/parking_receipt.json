 "html": "<div class=\"parking-receipt\"><style>.parking-receipt { font-family: Arial, sans-serif; } .receipt-header { text-align: center; border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 20px; } .receipt-header h2 { margin: 0; color: #1565c0; } .receipt-details table { width: 100%; border-collapse: collapse; margin: 15px 0; } .receipt-details td { padding: 5px 10px; border-bottom: 1px solid #eee; } .receipt-details td:first-child { font-weight: bold; width: 40%; } .receipt-footer { text-align: center; margin-top: 20px; padding-top: 10px; border-top: 2px solid #333; font-size: 12px; color: #666; }</style><div class=\"receipt-header\"><h2>SMART PARKING</h2><p>Parking Receipt</p></div><div class=\"receipt-details\"><table><tr><td>Receipt No:</td><td>{{ doc.name }}</td></tr><tr><td>Date:</td><td>{{ frappe.format_date(doc.payment_date) }}</td></tr><tr><td>Vehicle:</td><td>{{ doc.vehicle }}</td></tr><tr><td>Zone:</td><td>{{ doc.zone }}</td></tr><tr><td>Amount Paid:</td><td>{{ frappe.format_amount(doc.amount_paid, doc.currency) }}</td></tr><tr><td>Payment Method:</td><td>{{ doc.payment_method }}</td></tr></table></div><div class=\"receipt-footer\"><p>Thank you for parking with us!</p><p>Smart Parking Management System</p></div></div>",
